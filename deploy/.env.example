# DALVA stack: copy to deploy/.env next to docker-compose.yml and fill it in (in Dokploy: the
# service's Environment tab). See docs/deploy.md. Compose reads this for interpolation only;
# each service gets just the variables it needs.
# Secrets: openssl rand -hex 32 (hex only: the Postgres password goes into a URL). Every secret
# must differ from the others.
#
# The Telegram bot and the AI provider are not here: the first user to sign up owns the
# instance and sets them in the web app (Settings → Assistant setup).

# GitHub owner of the repo, lowercase (images are ghcr.io/<owner>/dalva-*).
GHCR_OWNER=replace-with-github-owner
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# The https origin users open, no path. Web, API and webhook share it. Must match the Dokploy domain.
PUBLIC_URL=https://dalva.example.com
# Signs session cookies and, derived, the agent's user tokens and the key that encrypts the bot
# token and AI key in the database. Changing it signs every user out and makes those stored
# secrets unreadable: the owner enters them again in Settings.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# The agent's service key. Shared by the API and the agent.
FINANCE_API_SERVICE_KEY=replace-with-openssl-rand-hex-32

# Optional. Default latest; set a short commit SHA to pin a release.
# API_IMAGE_TAG=latest
# WEB_IMAGE_TAG=latest
# AGENT_IMAGE_TAG=latest
# Optional. Dokploy sets its own project name; use dalva-staging for a second stack on one host.
# COMPOSE_PROJECT_NAME=dalva

# DALVA stack: copy to deploy/.env next to docker-compose.yml and fill it in. See docs/deploy.md.
# Compose reads this file for interpolation only; each service gets just the variables it needs.
# Secrets: openssl rand -hex 32 (hex only: the Postgres password goes into a URL, the webhook
# secret takes A-Za-z0-9_-). Every secret must differ from the others.

# ---- Stack ----
# Containers, volumes and networks are prefixed with it. Use dalva-staging for staging on the same host.
COMPOSE_PROJECT_NAME=dalva
# GitHub owner of the repo, lowercase (images are ghcr.io/<owner>/dalva-*).
GHCR_OWNER=replace-with-github-owner
# latest, or a short commit SHA to pin a release.
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest
AGENT_IMAGE_TAG=latest
# POSTGRES_IMAGE_TAG=18.7-alpine
# CLOUDFLARED_IMAGE_TAG=2026.10.7

# ---- Postgres ----
POSTGRES_USER=dalva
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_DB=dalva

# ---- API ----
NODE_ENV=production
# The https origin users open, no path. Web, API and webhook share it.
PUBLIC_URL=https://dalva.example.com
# Signs session cookies. Changing it signs every user out.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# Signs the user tokens the agent sends. Changing it invalidates them (they live 15 minutes).
FINANCE_API_TOKEN_SECRET=replace-with-openssl-rand-hex-32
# The agent's service key. Shared by the API and the agent.
FINANCE_API_SERVICE_KEY=replace-with-openssl-rand-hex-32
# Header Cloudflare sets to the client address. Auth rate limits key on it.
CLIENT_IP_HEADER=cf-connecting-ip
# Connections in the API pool. Default 10.
# DATABASE_POOL_MAX=10
# debug | info | warn | error
# API_LOG_LEVEL=info

# ---- Agent (Telegram) ----
# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token-from-botfather
# Bot username, no @.
TELEGRAM_BOT_USERNAME=dalva_bot
# Also sent as secret_token by `bun run telegram:webhook:set`.
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
# gateway (Vercel AI Gateway) or openrouter, and a model id for it.
AI_PROVIDER=gateway
AGENT_MODEL=anthropic/claude-sonnet-5-5
# Key of the selected provider (only that one is needed).
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
# Optional, defaults in parentheses.
# AGENT_LOG_LEVEL=info
# SESSION_IDLE_MINUTES=30
# RECOVERY_MAX_AGE_SECONDS=120
# AGENT_MAX_STEPS=6
# AGENT_MAX_OUTPUT_TOKENS=1024
# AGENT_TURN_TIMEOUT_SECONDS=45
# AGENT_RATE_LIMIT_TURNS=20
# AGENT_RATE_LIMIT_WINDOW_MINUTES=10
# DEFAULT_TIMEZONE=Africa/Luanda

# ---- Cloudflare Tunnel ----
# Zero Trust -> Networks -> Tunnels -> your tunnel -> token. Public hostname -> http://web:8080.
TUNNEL_TOKEN=replace-with-tunnel-token

# ---- Backup ----
# Daily dump time, HH:MM in UTC. Dumps more than BACKUP_KEEP_DAYS full days old are deleted.
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14

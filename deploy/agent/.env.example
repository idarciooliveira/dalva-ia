# Copy to .env next to docker-compose.yml (or paste into the panel's env editor).
# Never commit the real file. Empty values count as unset.

# ---- Compose (also visible in the container env, but ignored by the agent) ----
# GitHub owner of the image, lowercase: ghcr.io/<owner>/dalva-agent
GHCR_OWNER=
# latest, or a short SHA tag to pin / roll back.
AGENT_IMAGE_TAG=latest

# ---- Agent ----
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without the @. Same value as VITE_TELEGRAM_BOT_USERNAME on Vercel.
TELEGRAM_BOT_USERNAME=
# webhook in production. polling is dev-only: it deletes the registered webhook at boot and takes one update at a time.
TELEGRAM_MODE=webhook
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token; also passed as secret_token to setWebhook.
# 32-256 chars of A-Z a-z 0-9 _ - (base64 breaks this). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Origin of the Finance API: the Convex site URL (https://<deployment>.convex.site), not .convex.cloud.
FINANCE_API_URL=
# Same value as FINANCE_API_SERVICE_KEY in the Convex env. At least 32 chars.
# Generate: openssl rand -base64 48
FINANCE_API_SERVICE_KEY=
# Listen port. The compose file forces 3000; leave unset.
# PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Idle minutes before a chat starts a new session.
SESSION_IDLE_MINUTES=30
# Boot recovery replays unfinished events only if they arrived within this many seconds.
RECOVERY_MAX_AGE_SECONDS=120

# ---- Chat agent (LLM) ----
# gateway (Vercel AI Gateway) or openrouter.
AI_PROVIDER=gateway
# Model id for the selected provider. Required, no default. Any provider/model id works
# (both providers use <vendor>/<model>), e.g. anthropic/claude-sonnet-5-5 or openai/gpt-5.5.
AGENT_MODEL=anthropic/claude-sonnet-5-5
# Key of the selected provider (only that one is needed).
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
# Model calls per chat turn (tool round-trips + the answer), 1-10. Default 6.
# AGENT_MAX_STEPS=6
# Cap on output tokens per model call, 64-8192. Default: the provider's.
# AGENT_MAX_OUTPUT_TOKENS=
# Whole-turn timeout (history, model, tools), 5-300. Default 45.
# AGENT_TURN_TIMEOUT_SECONDS=45
# Chat turns allowed per user per window (in memory, per process). Default 20 per 10 minutes.
# AGENT_RATE_LIMIT_TURNS=20
# AGENT_RATE_LIMIT_WINDOW_MINUTES=10
# IANA time zone for "today" and default report months. Default Africa/Luanda.
# DEFAULT_TIMEZONE=Africa/Luanda

# ---- Webhook scripts (bun run telegram:webhook:*) ----
# Run from a dev machine with this file's values loaded into the shell (see docs/deploy-agent.md), not the VPS.
# Public origin of the tunnel hostname, no path. The script appends /webhooks/telegram.
AGENT_PUBLIC_URL=
# 1 to drop updates queued while the webhook was down. Default: keep them.
# DROP_PENDING_UPDATES=1

# VITE_CONVEX_URL comes from packages/backend/.env.local (written by `convex dev`).
# Set it here only to point the web app at a different deployment.
# VITE_CONVEX_URL=

# Telegram bot username (without @) for the Settings → Telegram deep link.
# Optional: without it, the page shows only the /start fallback.
VITE_TELEGRAM_BOT_USERNAME=

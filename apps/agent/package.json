{
  "name": "@mpf/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest",
    "test:once": "vitest run",
    "eval": "bun --env-file=../../.env eval/run.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.142",
    "@mpf/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@trpc/client": "^11.31.1",
    "@trpc/server": "^11.31.1",
    "ai": "^7.0.169",
    "grammy": "^1.46.0",
    "hono": "^4.13.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mpf/api": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}

# The agent needs only the API and its service key; everything else has a default.
# The Telegram bot and the AI provider are not env: the instance owner sets them in the web app
# (Settings → Assistant setup) and the agent reads them from the API, re-reading every 15s.
#
# Local dev: no file needed. `bun run dev:agent` takes both from apps/api/.env.local, and the bot
# polls (the API's PUBLIC_URL is http). Copy this to apps/agent/.env only to change a default.

# Origin of the API; /api/trpc is appended.
# FINANCE_API_URL=http://localhost:4000
# Same value as FINANCE_API_SERVICE_KEY on the API (at least 32 chars).
# FINANCE_API_SERVICE_KEY=
# PORT=8080
# debug | info | warn | error
# LOG_LEVEL=info
# A chat session idle for longer than this starts a new one.
# SESSION_IDLE_MINUTES=30
# Boot recovery replays unfinished events only if they arrived within this window; older ones get a "send it again" notice.
# RECOVERY_MAX_AGE_SECONDS=120
# Model calls per chat turn (tool round-trips + the answer), 1-10.
# AGENT_MAX_STEPS=6
# Cap on output tokens per model call, 64-8192.
# AGENT_MAX_OUTPUT_TOKENS=1024
# Whole-turn timeout (history, model, tools), 5-300.
# AGENT_TURN_TIMEOUT_SECONDS=45
# Chat turns allowed per user per window (in memory, per process).
# AGENT_RATE_LIMIT_TURNS=20
# AGENT_RATE_LIMIT_WINDOW_MINUTES=10
# IANA time zone for "today" and default report months.
# DEFAULT_TIMEZONE=Africa/Luanda

# `bun run eval` only (real model, fake API; not the bot): provider, model id and its key.
# AI_PROVIDER=gateway
# AGENT_MODEL=vendor/model
# AI_GATEWAY_API_KEY=
# OPENROUTER_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token-from-botfather
# Shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token (webhook mode only).
# 32-256 chars of A-Z a-z 0-9 _ -. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# webhook (production, behind the tunnel) or polling (local dev, no public URL needed).
TELEGRAM_MODE=polling
# Bot username without the @.
TELEGRAM_BOT_USERNAME=dalva_bot
# Origin of the Finance API (the Convex site URL). /api/v1 is appended.
FINANCE_API_URL=https://your-deployment.convex.site
# Same value as FINANCE_API_SERVICE_KEY on the backend (at least 32 chars).
FINANCE_API_SERVICE_KEY=
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# A chat session idle for longer than this starts a new one.
SESSION_IDLE_MINUTES=30
# Boot recovery replays unfinished events only if they arrived within this window; older ones get a "send it again" notice.
RECOVERY_MAX_AGE_SECONDS=120

# ---- Chat agent (LLM) ----
# gateway (Vercel AI Gateway) or openrouter.
AI_PROVIDER=gateway
# Model id for the selected provider. Required, no default. Any provider/model id works
# (both providers use <vendor>/<model>), e.g. anthropic/claude-sonnet-5-5 or openai/gpt-5.5.
AGENT_MODEL=anthropic/claude-sonnet-5-5
# Key of the selected provider (only that one is needed).
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
# Model calls per chat turn (tool round-trips + the answer), 1-10. Default 6.
# AGENT_MAX_STEPS=6
# Cap on output tokens per model call, 64-8192. Default 1024.
# AGENT_MAX_OUTPUT_TOKENS=1024
# Whole-turn timeout (history, model, tools), 5-300. Default 45.
# AGENT_TURN_TIMEOUT_SECONDS=45
# Chat turns allowed per user per window (in memory, per process). Default 20 per 10 minutes.
# AGENT_RATE_LIMIT_TURNS=20
# AGENT_RATE_LIMIT_WINDOW_MINUTES=10
# IANA time zone for "today" and default report months. Default Africa/Luanda.
# DEFAULT_TIMEZONE=Africa/Luanda

# Webhook scripts only (bun run telegram:webhook:set|info|delete). The agent itself ignores these.
# Public https origin of the tunnel hostname, no path.
# AGENT_PUBLIC_URL=https://agent.example.com
# 1 to drop queued updates on set/delete.
# DROP_PENDING_UPDATES=

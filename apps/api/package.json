{
  "name": "@mpf/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest",
    "test:once": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate-cli.ts",
    "migrate:convex": "bun scripts/migrate-from-convex.ts"
  },
  "dependencies": {
    "@mpf/finance-contract": "workspace:*",
    "better-auth": "^1.7.25",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}

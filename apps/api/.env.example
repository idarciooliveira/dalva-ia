# Local dev: copy to apps/api/.env.local (Bun loads it). Values match compose.dev.yml.
# Start Postgres first: docker compose -f compose.dev.yml up -d
DATABASE_URL=postgres://dalva:dalva@127.0.0.1:5432/dalva
# Connections in the pool. Default 10.
# DATABASE_POOL_MAX=10
PORT=4000
# development | test | production. production requires an https PUBLIC_URL.
# NODE_ENV=development
# Origin users reach the app at; web and API share it (the proxy sends /api/* here).
# Local dev: the web dev server, which proxies /api to this port.
PUBLIC_URL=http://localhost:3000
# Signs session cookies, at least 32 chars. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32-output-000000
# Signs the Finance API user tokens the chat agent sends, at least 32 bytes and not BETTER_AUTH_SECRET.
# Generate with: openssl rand -hex 32
FINANCE_API_TOKEN_SECRET=replace-with-openssl-rand-hex-32-output-111111
# The chat agent's key for the service routes (channel linking, inbound events), at least 32 bytes,
# distinct from both secrets above. Required in production. `bun run setup` generates it in
# apps/api/.env.local (the copy of this file), which `bun run dev:agent` reads too.
# Generate with: openssl rand -hex 32
# FINANCE_API_SERVICE_KEY=
# The chat bot's Telegram username (same as the agent's), for the Settings → Telegram
# deep link. Optional: without it the page shows only the /start message to send.
# TELEGRAM_BOT_USERNAME=
# Header the proxy sets to the client address (e.g. cf-connecting-ip). Turns on auth rate limits.
# Required in production; leave unset locally.
# CLIENT_IP_HEADER=
# debug | info | warn | error
LOG_LEVEL=info

# Tests only: a server where the suite may create and drop databases (dalva_test_*).
# Default: the compose server above.
# TEST_DATABASE_URL=postgres://dalva:dalva@127.0.0.1:5432/dalva

{
  "name": "my-personal-finance",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "lightningcss": "1.33.0"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun run --parallel --no-exit-on-error dev:backend dev:web dev:agent",
    "dev:web": "bun run --filter '@mpf/web' dev",
    "dev:backend": "bun run --filter '@mpf/backend' dev",
    "dev:agent": "bun scripts/wait-for-finance-api.ts && bun run --filter '@mpf/agent' dev",
    "dev:api": "bun run --filter '@mpf/api' dev",
    "build": "bun run --filter './apps/*' build",
    "build:web": "bun run --filter '@mpf/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter './packages/*' --filter '@mpf/agent' --filter '@mpf/api' test",
    "test:once": "bun run --filter './packages/*' --filter '@mpf/agent' --filter '@mpf/api' test:once",
    "test:e2e": "bun run --filter '@mpf/web' test:e2e",
    "db:generate": "bun run --filter '@mpf/api' db:generate",
    "db:migrate": "bun run --filter '@mpf/api' db:migrate"
  }
}

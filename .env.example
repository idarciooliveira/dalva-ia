# DALVA's only env file. Copy to .env in the repo root and fill it in; `bun run setup` does that
# for local dev and generates the secrets.
#
# Local dev: the API, the agent, the web dev server, the scripts and compose.dev.yml read it.
# Production: compose.yml reads it for interpolation and gives each service only what it needs
# (Dokploy: the service's Environment tab). See docs/deploy.md.
#
# The Telegram bot and the AI provider are not env: the first user to sign up owns the instance
# and sets them in the web app (Settings → Assistant setup).
#
# Secrets: openssl rand -hex 32 (hex only: the Postgres password goes into a URL). Every secret
# must differ from the others.

# ---- Shared: local dev and production ----

# The origin users open, no path. Web, API and the Telegram webhook share it.
# http (local dev) means the bot polls; https means saving the bot in Settings sets its webhook
# to <PUBLIC_URL>/webhooks/telegram. Production: the Dokploy domain.
PUBLIC_URL=http://localhost:3000
# Signs session cookies and, derived, the agent's user tokens and the key that encrypts the bot
# token and AI key in the database. Changing it signs every user out and makes those stored
# secrets unreadable: the owner enters them again in Settings.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# The agent's key for the API's service routes. The API and the agent get the same value.
FINANCE_API_SERVICE_KEY=replace-with-openssl-rand-hex-32

# ---- Local dev ----

# compose.dev.yml's Postgres. Change the port here and in DALVA_POSTGRES_PORT together.
DATABASE_URL=postgres://dalva:dalva@127.0.0.1:5432/dalva
# DALVA_POSTGRES_PORT=5432
# Tests only: a server where the suite may create and drop databases (dalva_test_*).
# Default: the compose server above.
# TEST_DATABASE_URL=postgres://dalva:dalva@127.0.0.1:5432/dalva
# The API's port (default 4000). The web dev server proxies /api/* there, unless DALVA_API_URL
# points elsewhere. `bun run dev:agent` keeps the agent on 8080.
# PORT=4000
# DALVA_API_URL=http://localhost:4000
# Connections in the API's pool. Default 10.
# DATABASE_POOL_MAX=10
# Header the proxy sets to the client address (e.g. cf-connecting-ip). Turns on auth rate limits.
# Leave unset locally; compose.yml sets it in production.
# CLIENT_IP_HEADER=
# debug | info | warn | error, for the API and the agent.
LOG_LEVEL=info

# Agent tuning. Defaults in apps/agent/src/config.ts.
# SESSION_IDLE_MINUTES=30
# RECOVERY_MAX_AGE_SECONDS=120
# AGENT_MAX_STEPS=6
# AGENT_MAX_OUTPUT_TOKENS=1024
# AGENT_TURN_TIMEOUT_SECONDS=45
# AGENT_RATE_LIMIT_TURNS=20
# AGENT_RATE_LIMIT_WINDOW_MINUTES=10
# DEFAULT_TIMEZONE=Africa/Luanda

# `bun run eval` in apps/agent only (real model, fake API; not the bot).
# AI_PROVIDER=gateway
# AGENT_MODEL=vendor/model
# AI_GATEWAY_API_KEY=
# OPENROUTER_API_KEY=

# ---- Production (compose.yml) ----
# Set PUBLIC_URL to the https origin and generate the secrets above, then these.

# GitHub owner of the repo, lowercase (images are ghcr.io/<owner>/dalva-*).
# GHCR_OWNER=replace-with-github-owner
# Generate. Only read when the database volume is first created.
# POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Optional. Default latest; set a short commit SHA to pin a release.
# API_IMAGE_TAG=latest
# WEB_IMAGE_TAG=latest
# AGENT_IMAGE_TAG=latest
# Optional. Dokploy sets its own project name; use dalva-staging for a second stack on one host.
# COMPOSE_PROJECT_NAME=dalva
